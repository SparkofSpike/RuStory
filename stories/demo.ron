// RuStory demo script.
//
// This is the vertical slice: background, sprites, typewriter dialogue, a
// branch, and a gameplay handover. It is also the reference for the script
// syntax, so keep it readable.
//
// Note the RON shape: struct variants take named fields, tuple variants take a
// value, and `Option` fields must say `Some(...)`.
//
// The text is English to match the rest of the repository. CJK shaping and line
// breaking are covered by a dedicated renderer test that feeds a Chinese
// paragraph through the same code path.
//
// Two gameplay systems appear here on purpose: the timed choice and the quiz. A
// script is not limited to one, and neither system knows the other exists.

Story(
    meta: (
        title: Some("RuStory demo"),
        author: Some("Slide 1"),
    ),
    start: "prologue",
    nodes: {
        "prologue": (
            beats: [
                SetBackground(image: Some("bg_classroom.png")),
                // Music is a beat, not a scene property: a track can change mid-node, and
                // the fade is part of the direction rather than something the host invents.
                Music(track: Some("classroom"), fade_ms: Some(1200)),
                Say(speaker: None, text: "After school, the classroom holds only two people."),
                ShowActor(actor: "yuki", pose: "yuki_smile", slot: Left),
                Say(speaker: Some("yuki"), text: "You haven't left yet?"),
                ShowActor(actor: "kai", pose: "kai_neutral", slot: Right),
                Say(speaker: Some("kai"), text: "I was waiting for you."),
                Say(speaker: Some("yuki"), text: "...Waiting for what?"),
                // A one-shot is an event, never replayed by a load: a door that slammed
                // once should not slam again because the player resumed mid-scene.
                Sound(clip: "chime", volume: Some(0.6)),
            ],
            exit: Choose(
                prompt: Some("How do you answer?"),
                choices: [
                    (label: "Tell her the truth", to: "honest"),
                    (label: "Change the subject", to: "deflect"),
                ],
            ),
        ),

        "honest": (
            beats: [
                HideActor(actor: "kai"),
                Say(speaker: Some("yuki"), text: "Then say it. I'm listening."),
            ],
            exit: Gameplay(spec: (
                system: "timer.timed_choice",
                config: Some((
                    prompt: Some("She is watching you, waiting for an answer."),
                    duration_ms: 5000,
                    options: [
                        "\"I like you.\"",
                        "\"...Never mind.\"",
                    ],
                    correct: 0,
                )),
                outcomes: {
                    "correct": "confession",
                    "wrong": "awkward",
                    "timeout": "awkward",
                },
            )),
        ),

        "deflect": (
            beats: [
                Say(speaker: Some("yuki"), text: "Changing the subject. That's you alright."),
                Music(track: None, fade_ms: Some(900)),
                Sound(clip: "door"),
                SetBackground(image: None),
                HideActor(actor: "yuki"),
                HideActor(actor: "kai"),
                Say(speaker: None, text: "Outside the window, the light went dim."),
            ],
            exit: End(ending: Some("Looked away")),
        ),

        "confession": (
            beats: [
                Say(speaker: Some("yuki"), text: "...Yeah. I've been waiting a long time to hear that."),
                Say(speaker: None, text: "Chalk dust drifted slowly through the light."),
                Say(speaker: Some("yuki"), text: "But you don't get to stop there. Two questions."),
            ],
            exit: Gameplay(spec: (
                system: "quiz.multi_round",
                config: Some((
                    prompt: Some("She has not finished with you."),
                    rounds: [
                        (
                            question: "When did you decide?",
                            options: ["Just now", "A long time ago"],
                            correct: 1,
                        ),
                        (
                            question: "Why didn't you say it sooner?",
                            options: ["I was afraid", "It slipped my mind"],
                            correct: 0,
                        ),
                    ],
                )),
                outcomes: {
                    "perfect": "understood",
                    "passed": "half_honest",
                    "failed": "misread",
                },
            )),
        ),

        "understood": (
            beats: [
                Say(speaker: Some("yuki"), text: "...I see. Same here, then."),
                Say(speaker: None, text: "The classroom held its breath."),
            ],
            exit: End(ending: Some("Understood")),
        ),

        "half_honest": (
            beats: [
                Say(speaker: Some("yuki"), text: "Half honest. I'll take it, for now."),
            ],
            exit: End(ending: Some("Half honest")),
        ),

        "misread": (
            beats: [
                Say(speaker: Some("yuki"), text: "...Never mind. Forget I asked."),
            ],
            exit: End(ending: Some("Misread")),
        ),

        "awkward": (
            beats: [
                Say(speaker: Some("yuki"), text: "...I see."),
                Say(speaker: None, text: "She didn't ask again. The bell rang."),
            ],
            exit: End(ending: Some("Left unsaid")),
        ),
    },
)
